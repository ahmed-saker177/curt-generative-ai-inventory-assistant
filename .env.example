# Select exactly one provider for Phase 2: groq or gemini.
LLM_PROVIDER=groq

# Groq configuration
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini configuration
# Create a key in Google AI Studio. Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
